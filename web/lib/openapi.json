              }
            ],
            "description": "conference or journal",
            "title": "Type"
          },
          "venue_id": {
            "title": "Venue Id",
            "type": "integer"
          }
        },
        "required": [
          "venue_id",
          "name"
        ],
        "title": "VenueRef",
        "type": "object"
      },
      "VenuesResponse": {
        "properties": {
          "venues": {
            "items": {
              "$ref": "#/components/schemas/VenueOption"
            },
            "title": "Venues",
            "type": "array"
          }
        },
        "required": [
          "venues"
        ],
        "title": "VenuesResponse",
        "type": "object"
      },
      "YearCount": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "year": {
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "year",
          "count"
        ],
        "title": "YearCount",
        "type": "object"
      }
    }
  },

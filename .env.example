# Copy to .env and edit. Never commit .env.
# Every value below is also the default in docker-compose.yml,
# so `docker compose up` works even without a .env file.

# --- PostgreSQL ---
POSTGRES_USER=scholarql
POSTGRES_PASSWORD=scholarql
POSTGRES_DB=scholarql
POSTGRES_PORT=5432

# --- MongoDB (Atlas Local) ---
MONGO_USER=scholarql
MONGO_PASSWORD=scholarql
MONGO_PORT=27017
MONGODB_DB=scholarql

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Added in later tasks ---

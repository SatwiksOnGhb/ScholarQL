# ScholarQL environment variables.
#
# LOCAL DEV: copy to .env and edit only what you need. Every local value below is also the
# default in docker-compose.yml, so `docker compose up` works without a .env file.
# PRODUCTION: these are set in each host's dashboard (see docs/deployment.md). Never commit .env.

# ---------------------------------------------------------------------------------------
# Local Docker stack (docker-compose.yml)
# ---------------------------------------------------------------------------------------
POSTGRES_USER=scholarql
POSTGRES_PASSWORD=scholarql
POSTGRES_DB=scholarql
POSTGRES_PORT=5432
# A's read-only role for B's engine (created by db/init/03-reader.sh)
SCHOLARQL_READER_PASSWORD=scholarql_reader
# pilot = load B's 353 real papers on first start (db/seed/pilot.sql); none = empty tables
SCHOLARQL_SEED=pilot

MONGO_USER=scholarql
MONGO_PASSWORD=scholarql
MONGO_PORT=27017

API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------------------------------
# API (FastAPI) - Render in production
# ---------------------------------------------------------------------------------------
# PostgreSQL. Local: built by docker-compose from POSTGRES_*.
# Production (Neon): postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/scholarql?sslmode=require
# DATABASE_URL=
# B's engine runs generated SQL as the read-only role. Local: built by docker-compose.
# Production: same Neon URL with scholarql_reader as the user.
# SCHOLARQL_DATABASE_URL=

# B's engine: optional LLM SQL generation. Without a key + model, B's rule-based compiler
# answers the questions it recognises. auto = Gemini if set, else Groq, else local.
# GEMINI_API_KEY=
# GEMINI_MODEL=            (a Gemini Flash model name from Google AI Studio)
# GROQ_API_KEY=
# GROQ_MODEL=              (a Llama model name from the Groq console)
# SCHOLARQL_GENERATOR=auto
# SCHOLARQL_STRATEGY=few_shot_correction   (zero_shot | few_shot | few_shot_correction)

# MongoDB. Local: built by docker-compose from MONGO_*. Jobs on your machine also read it,
# so set it to point the embedding/seed jobs at Atlas.
# Production (Atlas M0): mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=
MONGODB_DB=scholarql

# Comma-separated browser origins allowed to call the API.
# Production: https://<your-project>.vercel.app
CORS_ORIGINS=http://localhost:3000
# Optional regex for per-deploy origins (Vercel previews), e.g.
# CORS_ORIGIN_REGEX=https://scholarql(-[a-z0-9-]+)?\.vercel\.app

# dev | prod
APP_ENV=dev

# Per-IP rate limits (slowapi syntax)
# RATE_LIMIT_DEFAULT=60/minute
# RATE_LIMIT_HEAVY=10/minute

# Set by Render automatically; uvicorn binds to it (default 8000 locally)
# PORT=10000

# ---------------------------------------------------------------------------------------
# Web (Next.js) - Vercel in production
# ---------------------------------------------------------------------------------------
# Baked into the browser bundle at BUILD time; changing it needs a rebuild/redeploy.
# Production: https://scholarql-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Vercel only: lets Vercel use the pnpm version pinned in web/package.json
# ENABLE_EXPERIMENTAL_COREPACK=1

# ---------------------------------------------------------------------------------------
# Data jobs and teammates' keys
# ---------------------------------------------------------------------------------------
# OpenAlex (C's sample script, A's pipeline/): free key from https://openalex.org/settings/api
OPENALEX_API_KEY=
# Semantic Scholar (A's pipeline/enrich_semantic_scholar.py, TLDRs), optional
# SEMANTIC_SCHOLAR_API_KEY=
